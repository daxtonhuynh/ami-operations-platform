digraph ERD {
  graph [rankdir=TB, splines=spline, nodesep=0.25, ranksep=1.1, fontname="Helvetica", fontsize=22, labelloc=t, label=<<b>AMI Education - full relational model (93 tables)</b>>, pad=0.4, bgcolor="white", newrank=true];
