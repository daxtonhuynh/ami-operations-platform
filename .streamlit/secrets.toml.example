# Copy to .streamlit/secrets.toml (never commit the real file) or set the same keys in your hosting platform.
# Supabase: Project settings -> Database -> Connection pooling (session mode, port 5432), user ami_app.<project-ref>
DATABASE_URL = "postgresql://ami_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DEMO_MODE = "true"
DEMO_PASSWORD = "ami-demo"
